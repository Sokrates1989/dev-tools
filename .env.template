# === AI MODE SELECTION ===
# "api" → call AI automatically via API (must provide AI-API settings below)
# "manual" → print AI prompt and wait for user to copy-paste into ChatGPT, DeepSeek, etc.
AI_MODE="api"

# === AI API settings ===

# = Azure OpenAI =
API_PROVIDER="azure"             
API_BASE="https://<your-resource-name>.openai.azure.com/"
DEPLOYMENT="<your-deployment-name>"
API_VERSION="2024-08-01-preview"
API_KEY="" # Your Azure OpenAI API key.

# # = ChatGPT API =
# API_PROVIDER="openai"            
# API_BASE="https://api.openai.com/v1/"
# DEPLOYMENT="gpt-4o-mini"
# API_KEY=""  # Your OpenAI API key.

# === Default Model Parameters ===
TEMPERATURE="0.7"
MAX_TOKENS="4096"

# === Context Limits ===
# Maximum input tokens for the AI model (leave headroom for response)
# Common limits: gpt-4o = 128000, gpt-4o-mini = 128000, gpt-4 = 8192
# Set conservatively to avoid context_length_exceeded errors
MAX_CONTEXT_TOKENS="115000"
